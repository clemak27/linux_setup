{
  "yamllint-disable": {
    "prefix": "yamllint-disable",
    "body": [
      "# yamllint disable rule:${1:rule}"
    ],
    "description": "Inserts a yamllint disable comment"
  },
  "yamllint-disable-nl": {
    "prefix": "yamllint-disable-line",
    "body": [
      "# yamllint disable-line rule:${1:rule}"
    ],
    "description": "Inserts a yamllint disable-line comment"
  }
}
