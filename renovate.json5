{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "branchPrefix": "renovate/",
  "gitAuthor": "Renovate Bot <bot@renovateapp.com>",
  "forkProcessing": "disabled",
  "extends": [":semanticCommitScopeDisabled"],
  "commitMessageAction": "update",
  "customManagers": [
    {
      "customType": "regex",
      "managerFilePatterns": [".*\\.sh", ".*\\.tmpl"],
      // https://regex101.com/r/AxTOhn/1
      "matchStrings": [
        "# renovate: datasource=(?<datasource>.*?) depName=(?<depName>.*?)( versioning=(?<versioning>.*?))?\\s\\S+?=(?<currentValue>\\S+)"
      ]
    },
    {
      "customType": "regex",
      "managerFilePatterns": [".*\\.container$"],
      // https://regex101.com/r/1ysnFY/1
      "matchStrings": [
        "# renovate: datasource=(?<datasource>.*?) depName=(?<depName>.*?)( versioning=(?<versioning>.*?))?\\s\\S+?=.+:(?<currentValue>\\S+)"
      ]
    },
    {
      "customType": "regex",
      "managerFilePatterns": ["hk\\.pkl"],
      "matchStrings": [
        "package://github\\.com/(?<depName>jdx/hk)/releases/download/v(?<currentValue>\\d+\\.\\d+\\.\\d+)/hk@\\d+\\.\\d+\\.\\d+#"
      ],
      "datasourceTemplate": "github-releases",
      "versioningTemplate": "semver",
      "autoReplaceStringTemplate": "package://github.com/{{{depName}}}/releases/download/v{{{newValue}}}/hk@{{{newValue}}}#"
    }
  ],
  "packageRules": [
    {
      "matchManagers": [
        "mise"
      ],
      "matchUpdateTypes": [
        "minor",
        "patch"
      ],
      "automerge": true
    },
    {
      "matchPackageNames": [
        "jdx/hk"
      ],
      "matchUpdateTypes": [
        "minor",
        "patch"
      ],
      "automerge": true
    }
  ]
}
